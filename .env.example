# Model execution
OHMNI_MODEL_BACKEND=fake
OHMNI_MODEL_PROVIDER=fake
OHMNI_MODEL=fake-model
OHMNI_MODEL_TIMEOUT_SECONDS=60

# Circuit generation
OHMNI_GENERATOR=direct_spice

# Validation
OHMNI_VALIDATORS=ngspice
OHMNI_NGSPICE_EXECUTABLE=ngspice

# Output
OHMNI_OUTPUT_DIR=runs
OHMNI_ENABLE_DOTENV=1

# API credentials: only required for the selected API provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
